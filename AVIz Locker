-- *GetClosestTarget smells like a tournament bracket — one winner, everything else dust*
local function GetClosestTarget()
    local bestTarget = nil
    local bestDist   = math.huge
    local center     = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    local function EvaluateChar(char, isNPC)
        if not char or not char:FindFirstChild(State.AimbotBone) then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum or hum.Health <= 0 then return end

        -- Filter team (players only)
        if not isNPC then
            local owner = Players:GetPlayerFromCharacter(char)
            if owner == LocalPlayer then return end
        end

        local bone = char:FindFirstChild(State.AimbotBone)
        local screenPos, onScreen = Camera:WorldToViewportPoint(bone.Position)
        if not onScreen then return end

        local dist2D = Vector2.new(screenPos.X, screenPos.Y) - center
        local mag    = dist2D.Magnitude

        if mag < State.FOVRadius and mag < bestDist then
            bestDist   = mag
            bestTarget = bone
        end
    end

    -- Scan players
    if State.TargetPlayers then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                EvaluateChar(p.Character, false)
            end
        end
    end

    -- Scan NPCs (anything in workspace with Humanoid + HumanoidRootPart that isn't a player char)
    if State.TargetNPC then
        local playerChars = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Character then playerChars[p.Character] = true end
        end

        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Humanoid") then
                local char = obj.Parent
                if char and not playerChars[char] then
                    EvaluateChar(char, true)
                end
            end
        end
    end

    return bestTarget
end

