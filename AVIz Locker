-- ============================================================
-- SAFE EXECUTOR GLOBALS (some executors name these differently)
-- ============================================================
local setreadonly_  = setreadonly  or (function() end)
local newcclosure_  = newcclosure  or function(f) return f end

-- ============================================================
-- UTILITY
-- ============================================================

local function SafeCall(fn, ...)
    local ok, err = pcall(fn, ...)
    if not ok then warn("[Ghost] " .. tostring(err)) end
end

local function GetPlayerChars()
    local t = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then t[p.Character] = true end
    end
    return t
end

-- *GetClosestTarget — every frame the bracket narrows to one*
local function GetClosestTarget()
    local best     = nil
    local bestDist = math.huge
    local center   = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    local function Eval(char)
        if not char then return end
        local bone = char:FindFirstChild(State.AimbotBone)
        local hrp  = char:FindFirstChild("HumanoidRootPart")
        local hum  = char:FindFirstChildOfClass("Humanoid")
        if not bone or not hrp or not hum or hum.Health <= 0 then return end

        local sp, onScreen = Camera:WorldToViewportPoint(bone.Position)
        if not onScreen then return end

        local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
        if d < State.FOVRadius and d < bestDist then
            bestDist = d
            best     = bone
        end
    end

    if State.TargetPlayers then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                Eval(p.Character)
            end
        end
    end

    if State.TargetNPC then
        local pChars = GetPlayerChars()
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Humanoid") and obj.Parent and not pChars[obj.Parent] then
                Eval(obj.Parent)
            end
        end
    end

    return best
end

-- ============================================================
-- AIMBOT
-- ============================================================

RunService.RenderStepped:Connect(function()
    if not State.AimbotEnabled then return end
    if not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then return end

    local target = GetClosestTarget()
    if not target then return end

    -- *camera pivots like a hawk mid-dive — smooth, committed, silent*
    SafeCall(function()
        local cur    = Camera.CFrame
        local tgt    = CFrame.lookAt(cur.Position, target.Position)
        Camera.CFrame = cur:Lerp(tgt, math.clamp(State.AimbotSmoothing, 0.01, 1))
    end)
end)

-- ============================================================
-- SILENT AIM — __namecall hook with full pcall safety
-- ============================================================

-- *silent aim is a liar — it wears your bullet's face and mails it to someone else*
local hookOk = pcall(function()
    local mt     = getrawmetatable(game)
    local oldNC  = mt.__namecall
    setreadonly_(mt, false)

    mt.__namecall = newcclosure_(function(self, ...)
        local method = getnamecallmethod()
        local args   = { ... }

        if State.SilentAimEnabled and (method == "FireServer" or method == "InvokeServer") then
            local target = GetClosestTarget()
            if target then
                for i, v in ipairs(args) do
                    if typeof(v) == "Vector3" then
                        args[i] = target.Position
                    elseif typeof(v) == "CFrame" then
                        args[i] = CFrame.new(target.Position)
                    end
                end
            end
        end

        return oldNC(self, table.unpack(args))
    end)

    setreadonly_(mt, true)
end)

if not hookOk then
    warn("[Ghost] Silent aim hook failed — executor may not support __namecall patching")
end

