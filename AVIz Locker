local function createToggle(parent, labelText, yPos, callback)
    local Container = Instance.new("Frame")
    Container.Size = UDim2.new(1, -20, 0, 42)
    Container.Position = UDim2.new(0, 10, 0, yPos)
    Container.BackgroundColor3 = Color3.fromRGB(8, 0, 15)
    Container.BorderSizePixel = 0
    Container.Parent = parent

    local CCorner = Instance.new("UICorner")
    CCorner.CornerRadius = UDim.new(0, 6)
    CCorner.Parent = Container

    local CStroke = Instance.new("UIStroke")
    CStroke.Color = Color3.fromRGB(60, 0, 100)
    CStroke.Thickness = 1
    CStroke.Parent = Container

    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(0.7, 0, 1, 0)
    Label.Position = UDim2.new(0, 10, 0, 0)
    Label.BackgroundTransparency = 1
    Label.Text = labelText
    Label.TextColor3 = Color3.fromRGB(200, 180, 255)
    Label.TextSize = 13
    Label.Font = Enum.Font.Gotham
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = Container

    -- Toggle pill
    local ToggleBg = Instance.new("Frame")
    ToggleBg.Size = UDim2.new(0, 46, 0, 24)
    ToggleBg.Position = UDim2.new(1, -56, 0.5, -12)
    ToggleBg.BackgroundColor3 = Color3.fromRGB(30, 0, 50)
    ToggleBg.BorderSizePixel = 0
    ToggleBg.Parent = Container

    local TCorner = Instance.new("UICorner")
    TCorner.CornerRadius = UDim.new(1, 0)
    TCorner.Parent = ToggleBg

    local Knob = Instance.new("Frame")
    Knob.Size = UDim2.new(0, 18, 0, 18)
    Knob.Position = UDim2.new(0, 3, 0.5, -9)
    Knob.BackgroundColor3 = Color3.fromRGB(100, 0, 180)
    Knob.BorderSizePixel = 0
    Knob.Parent = ToggleBg

    local KCorner = Instance.new("UICorner")
    KCorner.CornerRadius = UDim.new(1, 0)
    KCorner.Parent = Knob

    local toggled = false

    local function toggle()
        toggled = not toggled
        local goal = toggled
            and {Position = UDim2.new(0, 25, 0.5, -9), BackgroundColor3 = Color3.fromRGB(180, 0, 255)}
            or  {Position = UDim2.new(0, 3, 0.5, -9),  BackgroundColor3 = Color3.fromRGB(100, 0, 180)}
        local bgGoal = toggled
            and {BackgroundColor3 = Color3.fromRGB(60, 0, 100)}
            or  {BackgroundColor3 = Color3.fromRGB(30, 0, 50)}
        TweenService:Create(Knob, TweenInfo.new(0.15), goal):Play()
        TweenService:Create(ToggleBg, TweenInfo.new(0.15), bgGoal):Play()
        callback(toggled)
    end

    -- PC click
    ToggleBg.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            toggle()
        end
    end)
    Container.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            toggle()
        end
    end)

    return Container
end

