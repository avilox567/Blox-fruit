    local DStroke = Instance.new("UIStroke")
    DStroke.Color = Color3.fromRGB(60, 0, 100)
    DStroke.Thickness = 1
    DStroke.Parent = Container

    local DLabel = Instance.new("TextLabel")
    DLabel.Size = UDim2.new(0.55, 0, 1, 0)
    DLabel.Position = UDim2.new(0, 10, 0, 0)
    DLabel.BackgroundTransparency = 1
    DLabel.Text = labelText
    DLabel.TextColor3 = Color3.fromRGB(200, 180, 255)
    DLabel.TextSize = 12
    DLabel.Font = Enum.Font.Gotham
    DLabel.TextXAlignment = Enum.TextXAlignment.Left
    DLabel.Parent = Container

    local currentIndex = 1
    local ValueLabel = Instance.new("TextLabel")
    ValueLabel.Size = UDim2.new(0.4, 0, 1, 0)
    ValueLabel.Position = UDim2.new(0.58, 0, 0, 0)
    ValueLabel.BackgroundTransparency = 1
    ValueLabel.Text = "◀ " .. options[1] .. " ▶"
    ValueLabel.TextColor3 = Color3.fromRGB(180, 0, 255)
    ValueLabel.TextSize = 12
    ValueLabel.Font = Enum.Font.GothamBold
    ValueLabel.TextXAlignment = Enum.TextXAlignment.Center
    ValueLabel.Parent = Container

    Container.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            currentIndex = currentIndex % #options + 1
            ValueLabel.Text = "◀ " .. options[currentIndex] .. " ▶"
            callback(options[currentIndex])
        end
    end)

    return Container
end

