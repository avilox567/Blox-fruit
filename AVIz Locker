-- Fixed toggle — updates visual on both create and click, no stale closure
local function MakeToggle(parent, label, stateKey, order)
    local row = Instance.new("Frame", parent)
    row.Size             = UDim2.new(1, 0, 0, 40)
    row.BackgroundColor3 = Color3.fromRGB(25, 15, 42)
    row.BorderSizePixel  = 0
    row.LayoutOrder      = order or 0
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 8)

    local lbl = Instance.new("TextLabel", row)
    lbl.Size             = UDim2.new(0.72, 0, 1, 0)
    lbl.Position         = UDim2.new(0, 10, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text             = label
    lbl.TextColor3       = Color3.fromRGB(210, 210, 230)
    lbl.Font             = Enum.Font.Gotham
    lbl.TextSize         = 13
    lbl.TextXAlignment   = Enum.TextXAlignment.Left

    local toggleFrame = Instance.new("Frame", row)
    toggleFrame.Size            = UDim2.new(0, 46, 0, 24)
    toggleFrame.Position        = UDim2.new(1, -56, 0.5, -12)
    toggleFrame.BackgroundColor3 = Color3.fromRGB(60, 60, 80)
    toggleFrame.BorderSizePixel = 0
    Instance.new("UICorner", toggleFrame).CornerRadius = UDim.new(1, 0)

    local knob = Instance.new("Frame", toggleFrame)
    knob.Size             = UDim2.new(0, 20, 0, 20)
    knob.Position         = UDim2.new(0, 2, 0.5, -10)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.BorderSizePixel  = 0
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local function Refresh()
        local on = State[stateKey]
        -- FIX: tween the toggle so it feels snappy
        TweenService:Create(toggleFrame, TweenInfo.new(0.12), {
            BackgroundColor3 = on and Color3.fromRGB(138, 43, 226) or Color3.fromRGB(60, 60, 80)
        }):Play()
        TweenService:Create(knob, TweenInfo.new(0.12), {
            Position = on and UDim2.new(1, -22, 0.5, -10) or UDim2.new(0, 2, 0.5, -10)
        }):Play()
    end

    Refresh()  -- set initial visual state

    -- FIX: clickable area covers the whole row, not just the tiny knob
    local hitbox = Instance.new("TextButton", row)
    hitbox.Size             = UDim2.new(1, 0, 1, 0)
    hitbox.BackgroundTransparency = 1
    hitbox.Text             = ""
    hitbox.ZIndex           = 5

    hitbox.MouseButton1Click:Connect(function()
        State[stateKey] = not State[stateKey]
        Refresh()
    end)
end

local function MakeSlider(parent, label, stateKey, min, max, order)
    local row = Instance.new("Frame", parent)
    row.Size             = UDim2.new(1, 0, 0, 58)
    row.BackgroundColor3 = Color3.fromRGB(25, 15, 42)
    row.BorderSizePixel  = 0
    row.LayoutOrder      = order or 0
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 8)

    local lbl = Instance.new("TextLabel", row)
    lbl.Size             = UDim2.new(1, -10, 0, 24)
    lbl.Position         = UDim2.new(0, 10, 0, 4)
    lbl.BackgroundTransparency = 1
    lbl.TextColor3       = Color3.fromRGB(210, 210, 230)
    lbl.Font             = Enum.Font.Gotham
    lbl.TextSize         = 13
    lbl.TextXAlignment   = Enum.TextXAlignment.Left

    local track = Instance.new("Frame", row)
    track.Size            = UDim2.new(1, -20, 0, 6)
    track.Position        = UDim2.new(0, 10, 0, 38)
    track.BackgroundColor3 = Color3.fromRGB(50, 30, 80)
    track.BorderSizePixel = 0
    Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

    local fill = Instance.new("Frame", track)
    fill.BackgroundColor3 = Color3.fromRGB(138, 43, 226)
    fill.BorderSizePixel  = 0
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local function UpdateFill()
        local pct = (State[stateKey] - min) / (max - min)
        fill.Size = UDim2.new(math.clamp(pct, 0, 1), 0, 1, 0)
        lbl.Text  = label .. ":  " .. tostring(math.floor(State[stateKey]))
    end

    UpdateFill()

    -- FIX: slider uses a transparent TextButton as drag surface (more reliable than InputBegan on Frame)
    local sliderBtn = Instance.new("TextButton", track)
    sliderBtn.Size             = UDim2.new(1, 0, 0, 20)
    sliderBtn.Position         = UDim2.new(0, 0, 0.5, -10)
    sliderBtn.BackgroundTransparency = 1
    sliderBtn.Text             = ""
    sliderBtn.ZIndex           = 5

    local sliding = false

    sliderBtn.MouseButton1Down:Connect(function()  sliding = true  end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then sliding = false end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if sliding and i.UserInputType == Enum.UserInputType.MouseMovement then
            local abs  = track.AbsolutePosition.X
            local size = track.AbsoluteSize.X
            local pct  = math.clamp((i.Position.X - abs) / size, 0, 1)
            State[stateKey] = min + (max - min) * pct
            UpdateFill()
        end
    end)
end

