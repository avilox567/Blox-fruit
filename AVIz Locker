-- *the camera pivots like a hawk mid-dive — smooth, inevitable, silent*
RunService.RenderStepped:Connect(function()
    if not State.AimbotEnabled then return end
    if not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then return end

    local target = GetClosestTarget()
    if not target then return end

    local targetPos = Camera:WorldToViewportPoint(target.Position)
    local currentCFrame = Camera.CFrame

    -- Spherical lerp toward target
    local targetCFrame = CFrame.lookAt(
        currentCFrame.Position,
        target.Position
    )

    Camera.CFrame = currentCFrame:Lerp(targetCFrame, State.AimbotSmoothing)
end)

-- ============================================================
-- SILENT AIM  (projectile redirection via __namecall hook)
-- ============================================================

-- *silent aim is a liar — it wears your bullet's face and sends it somewhere else*
local mt        = getrawmetatable(game)
local oldIndex  = mt.__namecall
setreadonly(mt, false)

mt.__namecall = newcclosure(function(self, ...)
    local args   = {...}
    local method = getnamecallmethod()

    if State.SilentAimEnabled and method == "FireServer" then
        -- Hook remote events that handle combat (works universally; refine per-game)
        local target = GetClosestTarget()
        if target then
            -- Patch any Vector3 argument that looks like an aim position
            for i, arg in ipairs(args) do
                if typeof(arg) == "Vector3" then
                    args[i] = target.Position
                end
                -- Some games pass CFrame
                if typeof(arg) == "CFrame" then
                    args[i] = CFrame.new(target.Position)
                end
            end
        end
    end

    return oldIndex(self, table.unpack(args))
end)

setreadonly(mt, true)

