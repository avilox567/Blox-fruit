local ESPObjects = {}

local function MakeESPForChar(char, label)
    if ESPObjects[char] then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local obj = {}

    -- Billboard (Name + Distance) — adorn HRP not char model
    local bb           = Instance.new("BillboardGui")
    bb.AlwaysOnTop     = true
    bb.Size            = UDim2.new(0, 200, 0, 48)
    bb.StudsOffset     = Vector3.new(0, 3.2, 0)
    bb.Adornee         = hrp   -- ← FIX: HRP not char
    bb.Parent          = ESPFolder

    local nameLabel    = Instance.new("TextLabel", bb)
    nameLabel.Size     = UDim2.new(1, 0, 0.5, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    nameLabel.TextStrokeTransparency = 0
    nameLabel.Font     = Enum.Font.GothamBold
    nameLabel.TextScaled = true
    nameLabel.Text     = label

    local distLabel    = Instance.new("TextLabel", bb)
    distLabel.Size     = UDim2.new(1, 0, 0.5, 0)
    distLabel.Position = UDim2.new(0, 0, 0.5, 0)
    distLabel.BackgroundTransparency = 1
    distLabel.TextColor3 = Color3.fromRGB(180, 180, 255)
    distLabel.TextStrokeTransparency = 0
    distLabel.Font     = Enum.Font.Gotham
    distLabel.TextScaled = true
    distLabel.Text     = "0m"

    -- SelectionBox — adorn HRP for reliable bounding box
    local box          = Instance.new("SelectionBox")
    box.Color3         = Color3.fromRGB(138, 43, 226)
    box.LineThickness  = 0.04
    box.SurfaceTransparency = 1
    box.Adornee        = hrp   -- ← FIX: HRP not char
    box.Parent         = ESPFolder

    -- Tracer line — FIX: no .Transparency on Drawing Line, use .Color directly
    local line         = Drawing.new("Line")
    line.Thickness     = 1.5
    line.Color         = Color3.fromRGB(255, 0, 80)   -- ← FIX: removed bogus .Transparency
    line.Visible       = false

    obj.bb         = bb
    obj.nameLabel  = nameLabel
    obj.distLabel  = distLabel
    obj.box        = box
    obj.line       = line

    ESPObjects[char] = obj
end

local function RemoveESPForChar(char)
    local obj = ESPObjects[char]
    if not obj then return end
    pcall(function() obj.bb:Destroy() end)
    pcall(function() obj.box:Destroy() end)
    pcall(function() obj.line:Remove() end)
    ESPObjects[char] = nil
end

RunService.RenderStepped:Connect(function()
    -- Always clean dead/killed chars regardless of toggle state
    for char in pairs(ESPObjects) do
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not char.Parent or (hum and hum.Health <= 0) then
            RemoveESPForChar(char)
        end
    end

    if not State.ESPEnabled then
        -- FIX: Properly wipe all ESP when toggled off
        for char in pairs(ESPObjects) do
            RemoveESPForChar(char)
        end
        return
    end

    -- Register new targets
    if State.TargetPlayers then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                MakeESPForChar(p.Character, p.Name)
            end
        end
    end

    if State.TargetNPC then
        local pChars = GetPlayerChars()
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Humanoid") then
                local char = obj.Parent
                if char and not pChars[char] then
                    MakeESPForChar(char, char.Name)
                end
            end
        end
    end

    -- Update per-object
    local localChar = LocalPlayer.Character
    local localHRP  = localChar and localChar:FindFirstChild("HumanoidRootPart")
    local center    = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for char, obj in pairs(ESPObjects) do
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then continue end

        obj.bb.Enabled       = State.ShowNames or State.ShowDist
        obj.nameLabel.Visible = State.ShowNames
        obj.distLabel.Visible = State.ShowDist
        obj.box.Visible       = State.ShowBoxes

        if localHRP then
            local d = math.floor((hrp.Position - localHRP.Position).Magnitude)
            obj.distLabel.Text = tostring(d) .. "m"
        end

        if State.ShowLines then
            local sp, onScreen = Camera:WorldToViewportPoint(hrp.Position)
            if onScreen then
                obj.line.Visible = true
                obj.line.From    = center
                obj.line.To      = Vector2.new(sp.X, sp.Y)
            else
                obj.line.Visible = false
            end
        else
            obj.line.Visible = false
        end
    end
end)

